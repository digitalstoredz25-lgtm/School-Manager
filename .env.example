# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/school-manager

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Email (SMTP) - example values for Gmail App Passwords
# For Gmail: enable 2FA, then create an "App Password" — do NOT use your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="School Manager <no-reply@schoolmanager.com>"
